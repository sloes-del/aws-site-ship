{
  "name": "aws-site-ship",
  "version": "0.2.0",
  "description": "Headless AWS CLI auth, Organizations CreateAccount, and S3 word-pair static deploys",
  "type": "module",
  "bin": {
    "aws-site-ship": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["aws", "s3", "cli", "static-site", "deploy", "headless", "organizations"],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1143.0",
    "@aws-sdk/client-organizations": "^3.1143.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sts": "^3.1143.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}