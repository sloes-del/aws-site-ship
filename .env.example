# aws-site-ship local secrets — DO NOT COMMIT real keys
# cp .env.example .env   then fill values

# ── onlinesim.io ──────────────────────────────────────────────────
# https://onlinesim.io/v2/profile/  (API tab)
ONLINESIM_API_KEY=your_onlinesim_api_key_here

# ── mercury.com ───────────────────────────────────────────────────
# https://app.mercury.com/settings/tokens  (open via: aws-site-ship mercury auth)
MERCURY_API_TOKEN=secret-token:your_mercury_token_here
